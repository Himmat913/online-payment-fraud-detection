# Optional. Copy to .streamlit/secrets.toml (never commit that file) to read
# transactions from MySQL instead of data/transactions_sample.csv.
# On Streamlit Cloud, paste the same content into the app's Secrets settings.

[mysql]
host = "YOUR_MYSQL_HOST"
user = "YOUR_MYSQL_USER"
password = "YOUR_MYSQL_PASSWORD"
database = "defaultdb"
port = 3306

# Either a path to the CA certificate file...
# ssl_ca = "path/to/ca.pem"
# ...or the certificate itself (useful on Streamlit Cloud):
# ssl_ca_content = """
# -----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----
# """
